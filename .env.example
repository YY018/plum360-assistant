# Which provider writes answers: groq or gemini. Defaults to groq when
# GROQ_API_KEY is set. Manual search (embeddings) always uses Gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Gemini Developer API credentials and embedding model (required for search).
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Comma-separated models tried when the primary is overloaded or rate limited.
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.8-flash
CHROMA_PERSIST_DIRECTORY=data/chroma_db
APP_ENV=development
# Extra browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=
# Manual PDF used for page previews (defaults to data/raw/manuals/...).
MANUAL_PDF_PATH=
