# Answers come from Groq (free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Manual search runs on this machine by default (no key, no quota).
# The model (~130 MB) downloads once into data/models/.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: Gemini. Set a key to add Gemini chat models as a last-resort
# fallback, or set EMBEDDING_PROVIDER=gemini to search with Gemini embeddings
# (that uses a separate index; run scripts.index_chunks after switching).
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.8-flash

CHROMA_PERSIST_DIRECTORY=data/chroma_db
APP_ENV=development
# Extra browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=
# Manual PDF used for page previews (defaults to data/raw/manuals/...).
MANUAL_PDF_PATH=

# Demo protection (keeps strangers from using up the model quota).
# Questions per client address per hour; 0 disables.
RATE_LIMIT_PER_HOUR=30
# Questions per day across everyone; 0 disables.
DAILY_REQUEST_BUDGET=400
# Longest question accepted.
MAX_QUESTION_CHARS=600
# If set, only people with this code can ask. Share links as
# https://your-site/?code=THE_CODE ; the browser remembers it for the session.
DEMO_ACCESS_CODE=
HF_TOKEN=
# Optional access code for the public demo (share links as ?code=...)
DEMO_ACCESS_CODE=
